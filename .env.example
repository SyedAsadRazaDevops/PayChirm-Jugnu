# Copy to .env for local runs:   cp .env.example .env
# .env is git-ignored. Never commit real keys. On Cloud Run use --set-env-vars / Secret Manager (see README).

# --- Local, no credentials needed (this is the default when nothing else is set) ---
PORT=8080
STORE=memory            # memory = local, lost on restart | firestore = Cloud Run
MOCK_GEMINI=true        # true = offline regex stand-in for Gemini, clearly labelled "mock" in the UI

# --- Live Gemini: pick ONE of these two ---
# A) Gemini API key from Google AI Studio (set MOCK_GEMINI=false or remove it)
# GEMINI_API_KEY=
# B) Vertex AI with application default credentials (no key). Needs GOOGLE_CLOUD_PROJECT below.
#    Locally: gcloud auth application-default login   (on Cloud Run the service account is used)
GEMINI_MODEL=gemini-3.5-flash-lite   # check ai.google.dev/gemini-api/docs/models for the current name
# GOOGLE_CLOUD_LOCATION=global       # Vertex AI location (global, or e.g. asia-south1)
# GEMINI_TIMEOUT_MS=15000

# --- Firestore relay (Cloud Run) ---
# GOOGLE_CLOUD_PROJECT=your-project-id
# SEED_DEMO_SHOP=true                # creates the synthetic demo shop (code JUGNU-DEMO) if it is missing
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}  # optional, see README

# --- Rules ---
# CONFIDENCE_THRESHOLD=0.7           # below this Gemini confidence an alert is Unverified
# DUPLICATE_WINDOW_MINUTES=1440      # same reference + amount + time inside this window is a duplicate
# MAX_ALERT_AGE_MINUTES=120          # alert time older than this (or in the future) is Unverified; 0 disables
# RATE_LIMIT_PER_MIN=60              # per IP on /api/alerts and /api/pair; 0 disables
# SERVE_STATIC=true                  # serve public/ from this service (handy on the bare Cloud Run URL)
